# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Turso appointment storage. Keep these server-side; never use VITE_ prefixes.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="replace-with-a-new-token"

# Clerk authentication. Keep the secret key server-side.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace-me"
CLERK_SECRET_KEY="sk_test_replace-me"

# Comma-separated Clerk user IDs or email addresses permitted to manage appointments.
# ADMIN_USER_IDS takes precedence when set; ADMIN_UIDS remains supported.
ADMIN_UIDS="user_replace_me"
ADMIN_EMAILS="quintinhealthcenter@gmail.com"

# Vercel Cron authenticates the scheduled in-site appointment reminder endpoint with this secret.
CRON_SECRET="generate-a-long-random-secret"
